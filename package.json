{
  "name": "@tttangerine/mju",
  "version": "1.7.0",
  "description": "Mju Agents: your tough but fair legal assistant, with a bundled Pi runtime and subagents",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "mju": "bin/mju.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "defaults",
    "public",
    "NOTICE",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -p 30142",
    "dev:webpack": "next dev --webpack -p 30142",
    "build": "next build --webpack",
    "start": "next start -p 30142",
    "test:backend": "node --test lib/mju-store.test.mjs lib/material-intelligence.test.mjs app/api/legal-routes.test.mjs \"app/api/cases/*/materials/route.test.mjs\" \"app/api/cases/*/materials/analyze/route.test.mjs\" \"app/api/cases/*/materials/convert/route.test.mjs\"",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"try{require('fs').accessSync('.next/BUILD_ID')}catch{console.error('✗ .next/BUILD_ID missing — run npm run build in a clean tree before publishing (never publish dev artifacts)');process.exit(1)}\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@lobehub/icons": "^5.6.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "adm-zip": "^0.6.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "next": "16.2.9",
    "pi-subagents": "^0.35.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "^2.7.0",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "author": "TTTangerineAir",
  "repository": {
    "type": "git",
    "url": "https://github.com/LegalNice/mju.git"
  },
  "bugs": "https://github.com/LegalNice/mju/issues",
  "homepage": "https://github.com/LegalNice/mju#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
